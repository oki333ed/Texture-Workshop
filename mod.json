{
	"geode": "5.5.3",
	"gd": {
		"win": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081",
		"android": "2.2081"
	},
	"version": "v1.0.3",
	"id": "chessdash543.tms",
	"name": "Texture Makers Workshop",
	"developer": "TMS Team",
	"description": "A fork from Texture Workshop :)",
	"dependencies": {
		"geode.texture-loader": {
			"required": true,
			"version": ">=1.9.0"
		}
	},
	"resources": {
		"spritesheets": {
			"TMSSheet": [
				"resources/TMSSheet/*.png"
			]
		},
		"sprites": [
			"resources/*.png"
		]
	},
	"settings": {
		"cert-verification": {
			"name": "Cert Verification",
			"description": "Enable Cert Verification",
			"type": "bool",
			"default": true
		},

		"version-filter": {
			"name": "Version Filter",
			"description": "Filter TPs to only show TPs that support the current GD Version",
			"type": "bool",
			"default": true
		}
	},
	"tags": [
		"universal", "utility", "interface", "enhancement", "customization"
	],
	"links": {
		"community": "https://discord.gg/YMGPn26WMN",
		"source": "https://github.com/Chessdash543/Texture-Workshop"
	}
}
